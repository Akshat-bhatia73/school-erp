{
  "name": "@erp/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./fixtures": "./scripts/fixtures.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "migrate:check": "node scripts/migrate.mjs --check",
    "fixtures": "tsx scripts/fixtures.mjs",
    "test:prepare": "node scripts/prepare-test-db.mjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
