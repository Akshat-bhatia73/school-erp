{
  "name": "school-erp",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @erp/web dev",
    "build": "pnpm --filter @erp/web build && rm -rf dist && cp -R apps/web/dist dist",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:contracts": "pnpm --filter @erp/contracts test",
    "build:web": "pnpm --filter @erp/web build",
    "db:migrate": "pnpm --filter @erp/db migrate",
    "db:fixtures": "pnpm --filter @erp/db fixtures",
    "db:test:prepare": "pnpm --filter @erp/db test:prepare",
    "test:db": "pnpm --filter @erp/db test",
    "test:authz": "pnpm --filter @erp/authz test",
    "test:api": "pnpm --filter @erp/api test",
    "dev:api": "pnpm --filter @erp/api dev",
    "test:web": "pnpm --filter @erp/web test -- --run",
    "test:security": "pnpm --filter @erp/security-tests test",
    "test:browser": "pnpm --filter @erp/browser-tests test",
    "check:assets": "node scripts/check-production-assets.mjs",
    "audit:deps": "pnpm audit --audit-level=high"
  },
  "packageManager": "pnpm@10.34.4"
}
