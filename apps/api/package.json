{
  "name": "@erp/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:logins": "tsx --env-file-if-exists=.env scripts/dev-logins.ts",
    "dev:seed": "tsx --env-file-if-exists=.env scripts/dev-seed.ts",
    "dev:seed-activity": "tsx scripts/seed-activity.ts",
    "ops:identity": "tsx --env-file-if-exists=.env scripts/disable-identity.ts",
    "dev:totp": "tsx --env-file-if-exists=.env scripts/dev-totp.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.ts",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.75",
    "@erp/authz": "workspace:*",
    "@erp/contracts": "workspace:*",
    "@erp/db": "workspace:*",
    "@sentry/node": "10.74.0",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.8",
    "ai": "7.0.106",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.3",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
