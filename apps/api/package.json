{
  "name": "@erp/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:logins": "tsx --env-file-if-exists=.env scripts/dev-logins.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@erp/authz": "workspace:*",
    "@erp/contracts": "workspace:*",
    "@erp/db": "workspace:*",
    "better-auth": "1.7.4",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
