# Development values only. These are the local Docker credentials from
# compose.db.yml and a throwaway secret. Never use this file in a deployment.
#
#   cp apps/api/.env.example apps/api/.env
#   pnpm dev:api
#
# pnpm dev:api loads apps/api/.env when it exists (node --env-file-if-exists).

AUTH_DATABASE_URL=postgres://erp_auth:erp_auth@127.0.0.1:54329/erp
IDENTITY_DATABASE_URL=postgres://erp_identity:erp_identity@127.0.0.1:54329/erp
DATABASE_URL=postgres://erp_runtime:erp_runtime@127.0.0.1:54329/erp

# Any 32+ character string. Generate your own: openssl rand -base64 32
AUTH_SECRET=development-only-secret-change-me-0000000000

# Seals sensitive text (the APAAR id) before it is stored. Base64 of 32 bytes:
# openssl rand -base64 32. Production refuses this example value. Keep it out
# of the database and back it up with the secret store: without it the sealed
# values cannot be read.
DATA_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1kYXRhLWtleS0wMDAwMDA=

# Optional. When set, GET /api/maintenance/sweep exists and accepts only
# Authorization: Bearer <CRON_SECRET>; Vercel Cron sends that header itself.
# Leave unset on a developer machine unless you are testing the sweep.
# CRON_SECRET=

# The single browser origin allowed to call this API (cookies and CSRF).
APP_ORIGIN=http://localhost:5173

# Only set to true behind a proxy you control that sets X-Forwarded-*.
API_TRUST_PROXY=false

# sandbox writes messages to memory and the log; provider stops startup.
DELIVERY_MODE=sandbox

# Sandbox delivery logs codes instead of sending them; never in real use.
# With NODE_ENV=production the server refuses to start on DELIVERY_MODE=sandbox
# unless this is set to true for a controlled staging run.
ALLOW_SANDBOX_DELIVERY=false

PORT=3001
# Loopback on a developer machine. The container sets 0.0.0.0 so the proxy
# in front of it can reach it; never publish that port to the internet.
HOST=127.0.0.1
NODE_ENV=development

# Development only. Publishes GET /api/dev/outbox, which hands back the
# one-time codes and reset tokens the sandbox held in memory, in clear.
# Never set this outside a developer machine; startup is refused when
# NODE_ENV=production.
DEV_SANDBOX_OUTBOX=false

# The disposable database the API tests run against. It is created and
# migrated by pnpm db:test:prepare and its rows are rewritten by every run,
# so it must never be "erp": that is the development database.
TEST_DATABASE_URL=postgres://erp_migrator:erp_migrator@127.0.0.1:54329/erp_test

# --- Production notes --------------------------------------------------
# With NODE_ENV=production the server additionally refuses to start when:
#   * AUTH_SECRET is the value above, or is shorter than 32 characters
#   * DATA_ENCRYPTION_KEY is the example value above
#   * APP_ORIGIN is not https (localhost and 127.0.0.1 excepted)
#   * DELIVERY_MODE=sandbox without ALLOW_SANDBOX_DELIVERY=true
#   * any database URL signs in as erp_migrator, which owns the schema
# Behind the Vercel /api rewrite also set API_TRUST_PROXY=true and
# APP_ORIGIN=https://<your site>. See docs/auth/RELEASE.md.

# The assistant (Task 24). Off unless true. ASSISTANT_PROVIDER is `gateway`
# (Vercel AI Gateway to Google Vertex; key from the gateway dashboard, or the
# project's OIDC token on Vercel) or `google` (Google AI Studio directly with
# GOOGLE_GENERATIVE_AI_API_KEY; a free-tier key is for test data only).
ASSISTANT_ENABLED=false
ASSISTANT_PROVIDER=gateway
ASSISTANT_MODEL=google/gemini-3.5-flash-lite
ASSISTANT_ZERO_DATA_RETENTION=true
# AI_GATEWAY_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
